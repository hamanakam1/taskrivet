{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://taskrivet.local/schemas/taskrivet.ticket-context.v2.json",
  "title": "TaskRivet ticket context envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "ticket", "task", "session", "authority", "provenance"],
  "properties": {
    "schema": {"const": "taskrivet.ticket-context.v2"},
    "ticket": {"$ref": "#/$defs/ticket"},
    "task": {"$ref": "#/$defs/task"},
    "session": {"$ref": "#/$defs/session"},
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["context_readonly", "ticket_mutation", "acceptance", "execution_authorized"],
      "properties": {
        "context_readonly": {"const": true},
        "ticket_mutation": {"const": false},
        "acceptance": {"const": false},
        "execution_authorized": {"const": false}
      }
    },
    "provenance": {"$ref": "#/$defs/provenance"}
  },
  "$defs": {
    "text": {"type": ["string", "null"], "maxLength": 1000},
    "ticket": {
      "type": "object", "additionalProperties": false,
      "required": ["key", "title"],
      "properties": {"key": {"type": ["string", "null"], "maxLength": 128}, "title": {"$ref": "#/$defs/text"}}
    },
    "task": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "objective", "acceptance"],
      "properties": {"id": {"type": ["string", "null"], "maxLength": 128}, "objective": {"$ref": "#/$defs/text"}, "acceptance": {"$ref": "#/$defs/text"}}
    },
    "session": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "status", "binding", "shared_count"],
      "properties": {"id": {"type": ["string", "null"], "maxLength": 128}, "status": {"type": ["string", "null"], "maxLength": 64}, "binding": {"enum": ["owner", "joined", "standalone"]}, "shared_count": {"type": "integer", "minimum": 0}}
    },
    "provenance": {
      "type": "object", "additionalProperties": false,
      "required": ["source", "generated_at"],
      "properties": {"source": {"type": "string", "maxLength": 200}, "generated_at": {"type": ["string", "null"], "maxLength": 64}}
    }
  }
}
