{
  "name": "taskrivet-desktop",
  "version": "0.3.0",
  "private": true,
  "description": "Taskrivet desktop workspace with embedded terminals",
  "author": "Taskrivet contributors",
  "license": "MIT",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "postinstall": "electron-builder install-app-deps",
    "build:mac": "electron-builder --mac dir --arm64"
  },
  "dependencies": {
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "node-pty": "1.1.0"
  },
  "devDependencies": {
    "electron": "45.0.0",
    "electron-builder": "26.15.3",
    "playwright": "1.56.1"
  },
  "build": {
    "appId": "org.taskrivet.desktop",
    "productName": "Taskrivet",
    "files": ["main.cjs", "preload.cjs", "policy.cjs", "session-service.cjs", "session-client.cjs", "ui/**/*", "package.json"],
    "extraResources": [{"from": "../taskrivet", "to": "core/taskrivet", "filter": ["**/*.py"]}],
    "mac": {"category": "public.app-category.developer-tools", "identity": null},
    "directories": {"output": "dist"}
  }
}
